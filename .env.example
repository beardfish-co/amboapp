# Public — exposed to the browser. Safe to commit these names.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-only — must be set in Vercel env (Production + Preview + Development).
# Used by /api/reflect-prompts to generate reflective prompts via Claude.
# If unset the route falls back silently to a safe shape library.
ANTHROPIC_API_KEY=sk-ant-...
